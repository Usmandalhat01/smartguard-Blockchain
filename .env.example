# ===========================================================================
# SmartGuard — environment configuration
#
# Copy to .env and fill in. Never commit .env; .gitignore already excludes it.
# ===========================================================================

# --- blockchain layer ------------------------------------------------------

# Sepolia JSON-RPC endpoint. Record the provider by name in the report —
# correction 17 specifically noted its absence from the latency evidence.
# Alchemy: https://eth-sepolia.g.alchemy.com/v2/<key>
# Infura:  https://sepolia.infura.io/v3/<key>
SEPOLIA_RPC_URL=

# Deploys the contracts and owns them. Fund from a Sepolia faucet.
DEPLOYER_PRIVATE_KEY=

# Signs oracle writes. A separate key, so a compromised relay is not a
# compromised owner (Section 3.15.2).
ORACLE_PRIVATE_KEY=

# For `npx hardhat verify`, which publishes source alongside the bytecode.
ETHERSCAN_API_KEY=

# --- presentation layer ----------------------------------------------------

# Signs session cookies. REQUIRED in production.
#   openssl rand -base64 48
SESSION_SECRET=

# Base URL of the FastAPI service. While unset, the interface uses a local
# deterministic stand-in and labels every figure as a placeholder.
NEXT_PUBLIC_API_URL=

# --- application layer -----------------------------------------------------

DATABASE_URL=postgresql://smartguard:smartguard@localhost:5432/smartguard
