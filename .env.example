# ===========================================================================
# SmartGuard — environment configuration
#
# Copy to .env and fill in. Never commit .env; .gitignore already excludes it.
# ===========================================================================

# --- blockchain layer ------------------------------------------------------

# Sepolia JSON-RPC endpoint. Record the provider by name in the report —
# correction 17 specifically noted its absence from the latency evidence.
# Alchemy: https://eth-sepolia.g.alchemy.com/v2/<key>
# Infura:  https://sepolia.infura.io/v3/<key>
SEPOLIA_RPC_URL=

# Deploys the contracts and owns them. Fund from a Sepolia faucet.
DEPLOYER_PRIVATE_KEY=

# Signs oracle writes. A separate key, so a compromised relay is not a
# compromised owner (Section 3.15.2).
ORACLE_PRIVATE_KEY=

# For `npx hardhat verify`, which publishes source alongside the bytecode.
ETHERSCAN_API_KEY=

# --- presentation layer ----------------------------------------------------

# Signs session cookies. REQUIRED in production.
#   openssl rand -base64 48
SESSION_SECRET=

# Base URL of the FastAPI service. While unset, the interface uses a local
# deterministic stand-in and labels every figure as a placeholder.
NEXT_PUBLIC_API_URL=

# --- application layer -----------------------------------------------------

# Note the `+psycopg` driver: requirements.txt installs psycopg v3, and a bare
# `postgresql://` URL makes SQLAlchemy reach for psycopg2, which is not there.
#
# PostgreSQL 15 is the deployment target (Table 3.3). To run it locally:
#   brew install postgresql@15 && brew services start postgresql@15
#   createdb smartguard
#
# Or, to get the service running today with nothing to install, SQLite works —
# the models use portable types for exactly this reason. Use it for development
# only; the figures in the report must come from the documented PostgreSQL 15.
#   DATABASE_URL=sqlite:///./smartguard.db
DATABASE_URL=postgresql+psycopg://smartguard:smartguard@localhost:5432/smartguard
